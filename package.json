{
  "name": "sermon-bank",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Open-source, private-by-default sermon archive for churches",
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply sermon-bank-local --local",
    "qa:staging": "node scripts/staging-qa.mjs",
    "test:unit": "node --experimental-strip-types --experimental-sqlite --test tests/*.test.mjs",
    "test:schema": "python3 scripts/check_schema.py && python3 scripts/check_auth_schema.py",
    "test": "pnpm run test:unit && pnpm run test:schema",
    "check": "pnpm run types && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "wrangler": "4.47.0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@10.28.0"
}
