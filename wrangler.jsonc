{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sermon-bank-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.05 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sermon-bank-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "PRIVATE_PDFS",
    "bucket_name": "sermon-bank-private-pdfs-not-provisioned"
  }],
  "env": {
    "staging": {
      "name": "sermon-bank-staging",
      "account_id": "4ef8a3ebba5a69f902bf2f935457fcd2",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "PUBLIC_ORIGIN": "https://sermons-preview.favor.church" },
      "routes": [{ "pattern": "sermons-preview.favor.church", "custom_domain": true }],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "sermon-bank-staging",
        "database_id": "9d4aee46-9a54-4699-a8d0-f212e29b8f98",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{
        "binding": "PRIVATE_PDFS",
        "bucket_name": "sermon-bank-private-pdfs-staging"
      }]
    },
    "production": {
      "name": "sermon-bank",
      "account_id": "4ef8a3ebba5a69f902bf2f935457fcd2",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 0.05, "invocation_logs": false },
        "traces": { "enabled": false }
      },
      "vars": { "PUBLIC_ORIGIN": "https://sermons.favor.church" },
      "routes": [{ "pattern": "sermons.favor.church", "custom_domain": true }],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "sermon-bank",
        "database_id": "c7eff5f1-a439-4b3e-9f42-1d669a4f3812",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{
        "binding": "PRIVATE_PDFS",
        "bucket_name": "sermon-bank-private-pdfs"
      }]
    }
  }
}
